[Unit]
Description=OMA-ID endpoint agent (lease check-ins + PAM authorization)
Documentation=https://github.com/Rovel/oma-id
# §11.2: the agent polls; it needs the network up to check in. It binds the
# PAM socket only after a successful first check-in (fail closed).
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/oma-id-agent run --config /etc/oma-id-agent.json
Restart=on-failure
RestartSec=5s

# Runtime + state directories the agent owns (§11.1).
RuntimeDirectory=oma-id
StateDirectory=oma-id

# Hardening: the agent needs root for shadow lookups (credential
# verification), account provisioning (useradd/groupadd) and the root-owned
# socket — the §11.1 privileged-helper split arrives with P4 and will allow
# strict ProtectSystem. What can be applied today:
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
